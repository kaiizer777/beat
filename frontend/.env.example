# Base URL for the Beat Spring Boot Backend API
NEXT_PUBLIC_API_BASE_URL=https://beat-fuvv.onrender.com

# PostgreSQL Connection String (Neon) for NextAuth & Prisma
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Auth.js / NextAuth Secret
AUTH_SECRET=your_32_byte_auth_secret_here

# Resend Settings (Used for RESEND_TARGET_EMAIL)
AUTH_RESEND_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Beat Digest <onboarding@resend.dev>
RESEND_TARGET_EMAIL=kaizerxdev@gmail.com

# Brevo Settings (Used for all other emails)
BREVO_API_KEY=xkeysib-your-brevo-api-key
