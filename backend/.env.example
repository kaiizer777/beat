# Server Configuration
PORT=8080

# PostgreSQL Database Configuration (Neon or Local Postgres)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/beatdb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Research APIs
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Groq LLM Inference
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Email Delivery - Resend (Primary)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Beat Digest <onboarding@resend.dev>
DIGEST_RECIPIENT_EMAIL=your_email@example.com
EMAIL_RESEND_TARGET=kaizerxdev@gmail.com

# Email Delivery - Brevo (Fallback)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_FROM_EMAIL=Beat Digest <kanekigaminz@gmail.com>

# Security & CORS
AUTH_SECRET=your_32_byte_auth_secret_here
INTERNAL_SECRET=your_internal_cron_secret_here
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://beat-alpha.vercel.app
