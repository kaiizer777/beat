# ==============================================================================
# Beat Docker Unified Environment Configuration Template
# Copy this file to .env before running: docker compose up --build
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# For Neon / Cloud PostgreSQL:
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your_neon_password_here

# NextAuth / Prisma PostgreSQL Connection URL:
DATABASE_URL=postgresql://neondb_owner:your_neon_password_here@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&pool_timeout=30

# (Optional: If using local PostgreSQL via docker compose --profile local-db up)
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/beatdb
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/beatdb

# ------------------------------------------------------------------------------
# 2. Authentication & Security
# ------------------------------------------------------------------------------
# Shared 32+ byte random string used by both NextAuth and Spring Boot JWT validator
AUTH_SECRET=generate_with_openssl_rand_base64_32

# Secret for internal pipeline triggers (e.g. GitHub Actions cron)
INTERNAL_SECRET=your_internal_cron_secret_key_here

# ------------------------------------------------------------------------------
# 3. AI & Search API Keys
# ------------------------------------------------------------------------------
# TinyFish Research API
TINYFISH_API_KEY=tf_your_tinyfish_api_key_here

# Groq LLM Inference API
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ------------------------------------------------------------------------------
# 4. Email Delivery Providers
# ------------------------------------------------------------------------------
# Resend (Magic Link & Primary Digest Delivery)
AUTH_RESEND_KEY=re_your_resend_api_key_here
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Beat Digest <onboarding@resend.dev>
RESEND_TARGET_EMAIL=kaizerxdev@gmail.com
DIGEST_RECIPIENT_EMAIL=kaizerxdev@gmail.com
EMAIL_RESEND_TARGET=kaizerxdev@gmail.com

# Brevo (Fallback Email Delivery)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_FROM_EMAIL=Beat Digest <kanekigaminz@gmail.com>

# ------------------------------------------------------------------------------
# 5. Service URLs & Networking
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://beat-alpha.vercel.app
